---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import BackToTop from '../components/BackToTop.astro';
import Mermaid from '../components/Mermaid.astro';
import { getCollection } from 'astro:content';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags } = Astro.props;

// Calculate reading time based on content
const entry = await Astro.props;
const content = await Astro.slots.render('default');
const textContent = content.replace(/<[^>]*>/g, '');
const wordCount = textContent.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const currentIndex = allPosts.findIndex(p => p.data.title === title);
const prevPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.prose {
				--tw-prose-bold: var(--text-primary);
				--tw-prose-headings: var(--text-primary);
				--tw-prose-code: var(--code-inline-text);
				color: var(--text-primary);
				max-width: 720px;
			}
			.prose :global(h1),
			.prose :global(h2),
			.prose :global(h3),
			.prose :global(h4),
			.prose :global(h5),
			.prose :global(h6) {
				color: var(--text-primary);
			}
			.prose :global(a) {
				color: var(--accent);
				text-decoration: underline;
				text-underline-offset: 2px;
			}
			.prose :global(a:hover) {
				color: var(--accent-dark);
			}
			.prose :global(p) {
				color: var(--text-primary);
			}
			.prose :global(ul),
			.prose :global(ol) {
				color: var(--text-primary);
			}
			.prose :global(blockquote) {
				border-left-color: var(--accent);
				color: var(--text-secondary);
			}
			.prose :global(hr) {
				border-color: var(--border-color);
			}
			.post-nav-card {
				transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
				background: var(--bg-primary);
				border-color: var(--border-color);
			}
			.post-nav-card {
				position: relative;
				overflow: hidden;
				border-radius: 18px;
			}
			.post-nav-card::after {
				content: attr(data-ch);
				position: absolute;
				right: 0.6rem;
				bottom: -1.2rem;
				font: 800 5.5rem/1 var(--font-display);
				color: var(--accent);
				opacity: 0.09;
				pointer-events: none;
				transition: opacity 0.3s ease, transform 0.3s ease;
			}
			.post-nav-card:not(.post-nav-card-next)::after { right: auto; left: 0.6rem; }
			.post-nav-card:hover::after { opacity: 0.2; transform: scale(1.08); }
			.post-nav-card:hover {
				background-color: var(--bg-secondary);
				transform: translateX(4px);
				box-shadow: var(--shadow-md);
			}
			.post-nav-card-next:hover {
				transform: translateX(-4px);
			}
			.post-nav-card :global(.nav-title) {
				color: var(--text-primary);
			}
			.post-nav-card :global(.nav-label) {
				color: var(--text-secondary);
			}
			.header-content {
				color: var(--text-muted);
			}
			.updated-date {
				color: var(--text-muted);
			}
			.title-text {
				color: var(--text-primary);
			}
			.tag-chip {
				background: var(--bg-secondary);
				color: var(--text-secondary);
				border-color: var(--border-color);
			}
			.tag-chip:hover {
				background: var(--bg-tertiary);
				color: var(--text-primary);
			}
			.back-link {
				color: var(--text-secondary);
			}
			.back-link:hover {
				color: var(--text-primary);
			}
			.post-nav-card {
				opacity: 0;
				animation: fadeInUp 0.5s ease forwards;
			}
			.post-nav-card:first-of-type {
				animation-delay: 0.2s;
			}
			.post-nav-card:last-of-type {
				animation-delay: 0.3s;
			}
		</style>
	</head>

	<body class="min-h-screen flex flex-col" style="background-color: var(--bg-primary);">
		<div id="reading-progress" class="reading-progress" style="width: 0%;"></div>
		<Header />

		<main id="main-content" class="flex-1 w-full max-w-4xl mx-auto px-4 py-8">
			<article>
				{heroImage && (
					<div class="mb-10 rounded-2xl overflow-hidden shadow-lg">
						<img
							width={1020}
							height={510}
							src={heroImage}
							alt=""
							class="w-full h-auto object-cover"
							loading="eager"
						/>
					</div>
				)}

				<header class="text-center mb-12 pb-8 border-b" style="border-color: var(--border-color);">
					<div class="flex flex-col items-center gap-2 mb-6">
						<time datetime={pubDate.toISOString()} class="text-sm header-content">
							<FormattedDate date={pubDate} />
							<span class="mx-2">·</span>
							<span>{readingTime} 分钟阅读</span>
						</time>
						{updatedDate && (
							<span class="text-xs updated-date italic">
								更新于 <FormattedDate date={updatedDate} />
							</span>
						)}
					</div>

					<h1 class="text-3xl md:text-4xl font-bold title-text mb-6 leading-tight">
						{title}
					</h1>

					{tags && tags.length > 0 && (
						<div class="flex flex-wrap justify-center gap-2">
							{tags.map(tag => (
								<a
									href={`/blog?tag=${tag}`}
									class="tag-chip px-3 py-1 rounded-full text-xs font-medium
										   hover:scale-105 active:scale-95
										   transition-all duration-150"
								>
									{tag}
								</a>
							))}
						</div>
					)}
				</header>

				<div class="prose mx-auto">
					<slot />
				</div>

				{(prevPost || nextPost) && (
					<nav class="flex flex-col sm:flex-row justify-between gap-4 mt-16 pt-8 border-t" style="border-color: var(--border-color);">
						{prevPost ? (
							<a
								href={`/blog/${prevPost.id}/`}
								class="post-nav-card flex-1 p-5 rounded-xl border text-left group"
								data-ch={prevPost.data.title.trim().charAt(0)}
							>
								<span class="nav-label text-xs mb-1 block">
									← 上一篇
								</span>
								<span class="nav-title font-medium transition-colors line-clamp-2">
									{prevPost.data.title}
								</span>
							</a>
						) : (
							<div class="flex-1"></div>
						)}

						{nextPost && (
							<a
								href={`/blog/${nextPost.id}/`}
								class="post-nav-card post-nav-card-next flex-1 p-5 rounded-xl border text-right group"
								data-ch={nextPost.data.title.trim().charAt(0)}
							>
								<span class="nav-label text-xs mb-1 block">
									下一篇 →
								</span>
								<span class="nav-title font-medium transition-colors line-clamp-2">
									{nextPost.data.title}
								</span>
							</a>
						)}
					</nav>
				)}

				<div class="text-center mt-8">
					<a
						href="/blog"
						class="back-link inline-flex items-center gap-2 text-sm
						       hover:gap-3 transition-all duration-200"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="h-4 w-4"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
						</svg>
						返回博客列表
					</a>
				</div>
			</article>
		</main>

		<Footer />
		<BackToTop />
		<Mermaid />

		<script is:inline>
			(function() {
				var progressBar = document.getElementById('reading-progress');
				if (!progressBar) return;

				function updateProgress() {
					var scrollTop = window.scrollY;
					var docHeight = document.documentElement.scrollHeight - window.innerHeight;
					var progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
					progressBar.style.width = progress + '%';
				}

				window.addEventListener('scroll', updateProgress, { passive: true });
				updateProgress();
			})();
		</script>

		<script is:inline>
			(function() {
				var prose = document.querySelector('.prose');
				if (!prose) return;

				/* ---- code blocks: language label + copy ---- */
				prose.querySelectorAll('pre').forEach(function(pre) {
					var code = pre.querySelector('code');
					var m = code && /language-([\w+-]+)/.exec(code.className);
					var lang = pre.getAttribute('data-language') || (m && m[1]) || '';
					if (lang === 'mermaid') return;
					if (pre.parentElement && pre.parentElement.classList.contains('code-block')) return;

					var wrap = document.createElement('div');
					wrap.className = 'code-block';

					var header = document.createElement('div');
					header.className = 'code-block-header';

					var langEl = document.createElement('span');
					langEl.className = 'code-block-lang';
					langEl.textContent = (lang && lang !== 'plaintext') ? lang : '';

					var btn = document.createElement('button');
					btn.type = 'button';
					btn.className = 'copy-code';
					btn.textContent = '复制';
					btn.setAttribute('aria-label', '复制代码');
					btn.addEventListener('click', function() {
						var text = code ? code.textContent : pre.textContent;
						navigator.clipboard.writeText(text || '').then(function() {
							btn.textContent = '✓ 已复制';
							btn.classList.add('done');
						}, function() { btn.textContent = '复制失败'; });
						setTimeout(function() { btn.textContent = '复制'; btn.classList.remove('done'); }, 1600);
					});

					header.appendChild(langEl);
					header.appendChild(btn);
					pre.parentNode.insertBefore(wrap, pre);
					wrap.appendChild(header);
					wrap.appendChild(pre);
				});

				/* ---- image lightbox ---- */
				var dlg = document.createElement('dialog');
				dlg.className = 'lightbox';
				var big = document.createElement('img');
				dlg.appendChild(big);
				dlg.addEventListener('click', function() { dlg.close(); });
				document.body.appendChild(dlg);
				prose.querySelectorAll('img').forEach(function(img) {
					if (img.closest('a')) return;
					img.classList.add('zoomable');
					img.addEventListener('click', function() {
						big.src = img.currentSrc || img.src; big.alt = img.alt || '';
						if (dlg.showModal) dlg.showModal();
					});
				});

				/* ---- table of contents ---- */
				var heads = Array.prototype.slice.call(prose.querySelectorAll('h2[id], h3[id]'));
				if (heads.length < 3) return;

				heads.forEach(function(h) {
					var a = document.createElement('a');
					a.href = '#' + h.id; a.className = 'anchor'; a.textContent = '#';
					a.setAttribute('aria-label', '链接到本节');
					h.appendChild(a);
				});

				function buildList() {
					var ul = document.createElement('ul');
					heads.forEach(function(h) {
						var li = document.createElement('li');
						li.className = h.tagName === 'H3' ? 'lv3' : 'lv2';
						var a = document.createElement('a');
						a.href = '#' + h.id;
						a.setAttribute('data-id', h.id);
						a.textContent = h.textContent.replace(/#$/, '');
						li.appendChild(a); ul.appendChild(li);
					});
					return ul;
				}

				// desktop sidebar
				var aside = document.createElement('aside');
				aside.className = 'toc-side';
				aside.setAttribute('aria-label', '目录');
				var t = document.createElement('p'); t.className = 'toc-title'; t.textContent = '目录';
				aside.appendChild(t); aside.appendChild(buildList());
				document.body.appendChild(aside);

				// mobile sheet
				var fab = document.createElement('button');
				fab.type = 'button'; fab.className = 'toc-fab'; fab.textContent = '目录';
				var sheet = document.createElement('div');
				sheet.className = 'toc-sheet'; sheet.hidden = true;
				var panel = document.createElement('div'); panel.className = 'toc-panel';
				var t2 = document.createElement('p'); t2.className = 'toc-title'; t2.textContent = '本文目录';
				panel.appendChild(t2); panel.appendChild(buildList());
				sheet.appendChild(panel);
				function closeSheet() { sheet.hidden = true; document.body.classList.remove('toc-open'); }
				fab.addEventListener('click', function() { sheet.hidden = false; document.body.classList.add('toc-open'); });
				sheet.addEventListener('click', function(e) { if (e.target === sheet || e.target.tagName === 'A') closeSheet(); });
				document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeSheet(); });
				document.body.appendChild(fab); document.body.appendChild(sheet);

				// scroll spy
				var links = document.querySelectorAll('.toc-side a, .toc-panel a');
				function setActive(id) {
					links.forEach(function(l) { l.classList.toggle('active', l.getAttribute('data-id') === id); });
				}
				if ('IntersectionObserver' in window) {
					var io = new IntersectionObserver(function(entries) {
						entries.forEach(function(en) { if (en.isIntersecting) setActive(en.target.id); });
					}, { rootMargin: '-80px 0px -70% 0px' });
					heads.forEach(function(h) { io.observe(h); });
				}
			})();
		</script>
	</body>
</html>
