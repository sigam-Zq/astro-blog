---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';

interface Props {
	showDiaryThemes?: boolean;
}

const { showDiaryThemes = false } = Astro.props;
---

<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent focus:text-white focus:rounded">
		跳过导航
	</a>

	<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="right-links">
			<a href="/blog" class="search-icon-link" aria-label="搜索文章" title="搜索文章">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
			</a>
			{showDiaryThemes ? (
				<div class="theme-menu" id="theme-menu">
					<button
						id="theme-toggle"
						class="theme-toggle theme-toggle--menu"
						type="button"
						aria-haspopup="true"
						aria-expanded="false"
						aria-controls="theme-popover"
						aria-label="外观与主题设置"
					>
						<svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<circle cx="12" cy="12" r="5"></circle>
							<line x1="12" y1="1" x2="12" y2="3"></line>
							<line x1="12" y1="21" x2="12" y2="23"></line>
							<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
							<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
							<line x1="1" y1="12" x2="3" y2="12"></line>
							<line x1="21" y1="12" x2="23" y2="12"></line>
							<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
							<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
						</svg>
						<svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
						</svg>
						<span class="theme-text" id="theme-current-label">手账</span>
						<svg class="theme-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<polyline points="6 9 12 15 18 9"></polyline>
						</svg>
					</button>
					<div id="theme-popover" class="theme-popover" role="dialog" aria-label="外观与主题设置" hidden>
						<div class="theme-popover-section">
							<p class="theme-popover-title">明暗模式</p>
							<div class="theme-mode-group">
								<button type="button" class="theme-mode-btn" data-set-mode="light" aria-pressed="false">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" aria-hidden="true">
										<circle cx="12" cy="12" r="5"></circle>
										<line x1="12" y1="1" x2="12" y2="3"></line>
										<line x1="12" y1="21" x2="12" y2="23"></line>
										<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
										<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
										<line x1="1" y1="12" x2="3" y2="12"></line>
										<line x1="21" y1="12" x2="23" y2="12"></line>
										<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
										<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
									</svg>
									<span>浅色</span>
								</button>
								<button type="button" class="theme-mode-btn" data-set-mode="dark" aria-pressed="false">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" aria-hidden="true">
										<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
									</svg>
									<span>深色</span>
								</button>
							</div>
						</div>
						<div class="theme-popover-divider"></div>
						<div class="theme-popover-section">
							<p class="theme-popover-title">日记风格</p>
							<div class="theme-style-list">
								<button type="button" class="theme-style-btn" data-set-diary-theme="journal" aria-pressed="false">
									<span class="theme-swatch theme-swatch--journal" aria-hidden="true"></span>
									<span class="theme-style-meta">
										<strong>纸质手账</strong>
										<small>暖纸衬线 · 时间轴</small>
									</span>
									<span class="theme-check" aria-hidden="true">✓</span>
								</button>
								<button type="button" class="theme-style-btn" data-set-diary-theme="terminal" aria-pressed="false">
									<span class="theme-swatch theme-swatch--terminal" aria-hidden="true"></span>
									<span class="theme-style-meta">
										<strong>开发者终端</strong>
										<small>等宽双栏 · 固定深色</small>
									</span>
									<span class="theme-check" aria-hidden="true">✓</span>
								</button>
								<button type="button" class="theme-style-btn" data-set-diary-theme="magazine" aria-pressed="false">
									<span class="theme-swatch theme-swatch--magazine" aria-hidden="true"></span>
									<span class="theme-style-meta">
										<strong>彩色杂志</strong>
										<small>玻璃卡片 · 网格索引</small>
									</span>
									<span class="theme-check" aria-hidden="true">✓</span>
								</button>
							</div>
						</div>
					</div>
				</div>
			) : (
				<button id="theme-toggle" class="theme-toggle" aria-label="切换主题">
					<svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<circle cx="12" cy="12" r="5"></circle>
						<line x1="12" y1="1" x2="12" y2="3"></line>
						<line x1="12" y1="21" x2="12" y2="23"></line>
						<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
						<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
						<line x1="1" y1="12" x2="3" y2="12"></line>
						<line x1="21" y1="12" x2="23" y2="12"></line>
						<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
						<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
					</svg>
					<svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
					</svg>
					<span class="theme-text">切换主题</span>
				</button>
			)}
			<div class="social-links">
				<a href="blog/resume/" target="_blank">
					<span class="sr-only">这里是小Z的一个自我介绍</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
						><path
							fill="currentColor"
							d="M11.19 12.195c2.016-.24 3.77-1.475 3.99-2.603.348-1.778.32-4.339.32-4.339 0-3.47-2.286-4.488-2.286-4.488C12.062.238 10.083.017 8.027 0h-.05C5.92.017 3.942.238 2.79.765c0 0-2.285 1.017-2.285 4.488l-.002.662c-.004.64-.007 1.35.011 2.091.083 3.394.626 6.74 3.78 7.57 1.454.383 2.703.463 3.709.408 1.823-.1 2.847-.647 2.847-.647l-.06-1.317s-1.303.41-2.767.36c-1.45-.05-2.98-.156-3.215-1.928a3.614 3.614 0 0 1-.033-.496s1.424.346 3.228.428c1.103.05 2.137-.064 3.188-.189zm1.613-2.47H11.13v-4.08c0-.859-.364-1.295-1.091-1.295-.804 0-1.207.517-1.207 1.541v2.233H7.168V5.89c0-1.024-.403-1.541-1.207-1.541-.727 0-1.091.436-1.091 1.296v4.079H3.197V5.522c0-.859.22-1.541.66-2.046.456-.505 1.052-.764 1.793-.764.856 0 1.504.328 1.933.983L8 4.39l.417-.695c.429-.655 1.077-.983 1.934-.983.74 0 1.336.259 1.791.764.442.505.661 1.187.661 2.046v4.203z"
						></path></svg
					>
				</a>
				<!-- <a href="https://twitter.com/astrodotbuild" target="_blank">
				<span class="sr-only">Follow Astro on Twitter</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"
					></path></svg
				>
			</a> -->
				<a href="https://github.com/sigam-Zq" target="_blank">
					<span class="sr-only">Go to Astro's GitHub repo</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
						><path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path></svg
					>
				</a>
			</div>
		</div>
	</nav>
</header>

{showDiaryThemes ? (
	<script is:inline>
		(function() {
			const DIARY_THEMES = ['journal', 'terminal', 'magazine'];
			const DIARY_LABELS = {
				journal: '手账',
				terminal: '终端',
				magazine: '杂志',
			};

			const savedTheme = localStorage.getItem('theme');
			const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			const theme = savedTheme || (systemPrefersDark ? 'dark' : 'light');
			document.documentElement.dataset.theme = theme;

			const savedDiaryTheme = localStorage.getItem('diary-theme');
			const initialDiaryTheme = DIARY_THEMES.includes(savedDiaryTheme || '') ? savedDiaryTheme : 'journal';
			document.documentElement.dataset.diaryTheme = initialDiaryTheme;

			const menu = document.getElementById('theme-menu');
			const popover = document.getElementById('theme-popover');
			const toggleBtn = document.getElementById('theme-toggle');
			const currentLabel = document.getElementById('theme-current-label');
			if (!popover) return;

			const modeBtns = popover.querySelectorAll('[data-set-mode]');
			const styleBtns = popover.querySelectorAll('[data-set-diary-theme]');

			function syncUI() {
				const currentMode = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
				const currentStyle = DIARY_THEMES.includes(document.documentElement.dataset.diaryTheme || '')
					? document.documentElement.dataset.diaryTheme
					: 'journal';

				modeBtns.forEach(function(btn) {
					const active = btn.getAttribute('data-set-mode') === currentMode;
					btn.setAttribute('aria-pressed', String(active));
					btn.classList.toggle('is-active', active);
				});

				styleBtns.forEach(function(btn) {
					const active = btn.getAttribute('data-set-diary-theme') === currentStyle;
					btn.setAttribute('aria-pressed', String(active));
					btn.classList.toggle('is-active', active);
				});

				if (currentLabel && currentStyle) {
					currentLabel.textContent = DIARY_LABELS[currentStyle] || '手账';
				}
			}

			function setOpen(open) {
				popover.hidden = !open;
				if (toggleBtn) {
					toggleBtn.setAttribute('aria-expanded', String(open));
				}
			}

			syncUI();

			if (toggleBtn) {
				toggleBtn.addEventListener('click', function() {
					setOpen(popover.hidden);
				});
			}

			modeBtns.forEach(function(btn) {
				btn.addEventListener('click', function() {
					const nextMode = btn.getAttribute('data-set-mode');
					if (nextMode !== 'light' && nextMode !== 'dark') return;
					document.documentElement.dataset.theme = nextMode;
					localStorage.setItem('theme', nextMode);
					syncUI();
				});
			});

			styleBtns.forEach(function(btn) {
				btn.addEventListener('click', function() {
					const nextStyle = btn.getAttribute('data-set-diary-theme');
					if (!DIARY_THEMES.includes(nextStyle || '')) return;
					document.documentElement.dataset.diaryTheme = nextStyle;
					localStorage.setItem('diary-theme', nextStyle);
					syncUI();
				});
			});

			document.addEventListener('click', function(e) {
				if (!popover.hidden && menu && e.target instanceof Node && !menu.contains(e.target)) {
					setOpen(false);
				}
			});

			document.addEventListener('keydown', function(e) {
				if (e.key === 'Escape' && !popover.hidden) {
					setOpen(false);
					if (toggleBtn) toggleBtn.focus();
				}
			});
		})();
	</script>
) : (
	<script is:inline>
		(function() {
			const savedTheme = localStorage.getItem('theme');
			const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			const theme = savedTheme || (systemPrefersDark ? 'dark' : 'light');

			document.documentElement.dataset.theme = theme;

			const toggleBtn = document.getElementById('theme-toggle');
			if (toggleBtn) {
				toggleBtn.addEventListener('click', function() {
					const current = document.documentElement.dataset.theme;
					const next = current === 'dark' ? 'light' : 'dark';
					document.documentElement.dataset.theme = next;
					localStorage.setItem('theme', next);
				});
			}
		})();
	</script>
)}
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--bg-primary);
		box-shadow: var(--shadow-sm);
		border-bottom: 1px solid var(--border-color);
		transition: background-color 0.3s ease, border-color 0.3s ease;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: var(--text-primary);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--text-primary);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		transition: color 0.2s ease, border-color 0.2s ease;
		position: relative;
	}
	nav a::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 0;
		height: 4px;
		background: var(--accent);
		transition: width 0.2s ease;
	}
	nav a:hover::after,
	nav a.active::after {
		width: 100%;
	}
	nav a:hover {
		color: var(--accent);
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: transparent;
	}
	.right-links {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.theme-toggle {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0.75rem;
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		border-radius: 8px;
		cursor: pointer;
		color: var(--text-primary);
		font-size: 0.875rem;
		transition: all 0.2s ease;
	}
	.theme-toggle:hover {
		background: var(--bg-tertiary);
		border-color: var(--border-muted);
	}
	.theme-toggle svg {
		width: 18px;
		height: 18px;
	}
	.sun-icon {
		display: none;
	}
	.moon-icon {
		display: block;
	}
	[data-theme="dark"] .sun-icon {
		display: block;
	}
	[data-theme="dark"] .moon-icon {
		display: none;
	}
	.theme-text {
		color: var(--text-secondary);
	}
	.theme-menu {
		position: relative;
		z-index: 50;
	}
	.theme-chevron {
		width: 14px !important;
		height: 14px !important;
		color: var(--text-muted);
		transition: transform 0.15s ease;
	}
	.theme-toggle--menu[aria-expanded="true"] .theme-chevron {
		transform: rotate(180deg);
	}
	.theme-popover {
		position: absolute;
		top: calc(100% + 8px);
		right: 0;
		width: 256px;
		max-width: calc(100vw - 1.5rem);
		z-index: 1000;
		background: var(--bg-primary);
		border: 1px solid var(--border-color);
		border-radius: 12px;
		box-shadow: var(--shadow-md);
		padding: 12px;
		text-align: left;
	}
	.theme-popover[hidden] {
		display: none !important;
	}
	.theme-popover-section {
		display: grid;
		gap: 8px;
	}
	.theme-popover-title {
		margin: 0;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--text-muted);
	}
	.theme-popover-divider {
		height: 1px;
		background: var(--border-color);
		margin: 10px 0;
	}
	.theme-mode-group {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 6px;
	}
	.theme-mode-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		padding: 7px 10px;
		border-radius: 8px;
		border: 1px solid var(--border-color);
		background: var(--bg-secondary);
		color: var(--text-secondary);
		font-size: 0.8125rem;
		cursor: pointer;
		transition: all 0.15s ease;
	}
	.theme-mode-btn:hover {
		background: var(--bg-tertiary);
		color: var(--text-primary);
	}
	.theme-mode-btn.is-active {
		background: var(--bg-primary);
		border-color: var(--accent);
		color: var(--accent);
		font-weight: 600;
		box-shadow: 0 0 0 1px var(--accent) inset;
	}
	.theme-style-list {
		display: grid;
		gap: 6px;
	}
	.theme-style-btn {
		display: flex;
		align-items: center;
		gap: 10px;
		width: 100%;
		padding: 8px 10px;
		border-radius: 9px;
		border: 1px solid transparent;
		background: var(--bg-secondary);
		color: var(--text-primary);
		text-align: left;
		cursor: pointer;
		transition: all 0.15s ease;
	}
	.theme-style-btn:hover {
		background: var(--bg-tertiary);
		border-color: var(--border-muted);
	}
	.theme-style-btn.is-active {
		background: var(--bg-primary);
		border-color: var(--accent);
		box-shadow: 0 0 0 1px var(--accent) inset;
	}
	.theme-swatch {
		width: 24px;
		height: 24px;
		border-radius: 6px;
		flex-shrink: 0;
		border: 1px solid rgba(128, 128, 128, 0.25);
	}
	.theme-swatch--journal {
		background: linear-gradient(135deg, #fbf6ea 55%, #9c4a2f 55%);
	}
	.theme-swatch--terminal {
		background: linear-gradient(135deg, #0e1116 58%, #3ddc97 58%);
	}
	.theme-swatch--magazine {
		background: linear-gradient(135deg, #ff9a8b, #a18cd1 55%, #5fc3e4);
	}
	.theme-style-meta {
		display: grid;
		gap: 1px;
		flex: 1;
		min-width: 0;
	}
	.theme-style-meta strong {
		font-size: 0.85rem;
		font-weight: 600;
		line-height: 1.2;
		color: var(--text-primary);
	}
	.theme-style-meta small {
		font-size: 0.72rem;
		line-height: 1.2;
		color: var(--text-muted);
	}
	.theme-check {
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--accent);
		opacity: 0;
	}
	.theme-style-btn.is-active .theme-check {
		opacity: 1;
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	.social-links a {
		color: var(--text-secondary);
		transition: color 0.2s ease;
	}
	.social-links a:hover {
		color: var(--text-primary);
	}
	.search-icon-link {
		display: flex;
		align-items: center;
