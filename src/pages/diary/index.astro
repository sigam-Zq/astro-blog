---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DiaryApp from '../../components/diary/DiaryApp';
import themeCSS from '@awesome.me/webawesome/dist/styles/themes/default.css?inline';
import '@awesome.me/webawesome/dist/styles/utilities/scroll-lock.css';
import { scopeDiaryTheme } from '../../components/diary/theme';
const diaryTheme = scopeDiaryTheme(themeCSS);
---
<!doctype html>
<html lang="zh-CN">
 <head>
  <BaseHead title="私人日记" description="私人日记" />
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <meta name="referrer" content="no-referrer" />
  <style is:inline set:html={diaryTheme} />
 </head>
 <body>
  <div class="diary-site-header"><Header showDiaryThemes={true} /></div>
  <main id="main-content" class="diary-main"><DiaryApp client:only="preact"><p slot="fallback">正在加载日记…</p></DiaryApp></main>
  <Footer />
 </body>
</html>
<style>
 .diary-main {
  width: 100%;
  max-width: none;
  padding: 0;
 }
 @media (max-width: 720px) {
  .diary-site-header :global(nav) {
   display: grid;
   grid-template-columns: minmax(0, 1fr) auto;
   gap: 0.25rem 1rem;
   padding-top: 0.5rem;
  }
  .diary-site-header :global(nav h2) {
   white-space: nowrap;
  }
  .diary-site-header :global(.right-links) {
   grid-column: 2;
   grid-row: 1;
   gap: 0.5rem;
  }
  .diary-site-header :global(.internal-links) {
   grid-column: 1 / -1;
   display: flex;
  }
  .diary-site-header :global(.internal-links a) {
   flex: 1;
   text-align: center;
   padding: 0.5rem;
  }
  .diary-site-header :global(.theme-toggle),
  .diary-site-header :global(.search-icon-link) {
   min-width: 44px;
   min-height: 44px;
   justify-content: center;
  }
 }
</style>
