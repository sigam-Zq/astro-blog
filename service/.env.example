# Copy to runtime.env for pure environment configuration. With a YAML config, include
# only fields you intend to override; remove all other entries.
HTTP_ADDR=0.0.0.0:8080
APP_ORIGIN=http://localhost:4321
REQUIRE_HTTPS=false
# Optional direct TLS / mTLS on the Go server:
# TLS_CERT_FILE=/etc/letsencrypt/live/api.blogs.zqsrh.com/fullchain.pem
# TLS_KEY_FILE=/etc/letsencrypt/live/api.blogs.zqsrh.com/privkey.pem
# TLS_CLIENT_CA_FILE=/etc/diary/ca.crt
ADMIN_USERNAME=REPLACE_WITH_USERNAME
# raw env_file format: paste the Argon2id value without quotes or $$ escaping.
ADMIN_PASSWORD_HASH=REPLACE_WITH_ARGON2ID_HASH
# Alternatively remove ADMIN_PASSWORD_HASH and use ADMIN_PASSWORD.
S3_ENDPOINT=http://dev.zqsrh.com:9000
S3_REGION=us-east-1
S3_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
S3_PREFIX=diary/v1/
S3_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
S3_FORCE_PATH_STYLE=true
